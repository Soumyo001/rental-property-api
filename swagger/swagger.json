{
    "swagger": "2.0",
    "info": {
        "title": "Rental Property API",
        "description": "Main route of rental property API\n",
        "version": "1.0.0",
        "contact": {
            "email": "admin@w3engineers.com"
        }
    },
    "basePath": "/v1",
    "paths": {
        "/properties/": {
            "get": {
                "tags": [
                    "properties"
                ],
                "description": "List properties with search params\n\u003cbr\u003e",
                "operationId": "PropertyController.List properties",
                "parameters": [
                    {
                        "in": "query",
                        "name": "min_price",
                        "description": "lowest usd_price to include",
                        "type": "number",
                        "format": "double"
                    },
                    {
                        "in": "query",
                        "name": "max_price",
                        "description": "highest usd_price to include",
                        "type": "number",
                        "format": "double"
                    },
                    {
                        "in": "query",
                        "name": "min_star_rating",
                        "description": "lowest star rating to include",
                        "type": "integer",
                        "format": "int64"
                    },
                    {
                        "in": "query",
                        "name": "min_review_score",
                        "description": "lowest review score to include",
                        "type": "number",
                        "format": "double"
                    },
                    {
                        "in": "query",
                        "name": "min_reviews",
                        "description": "lowest review count to include",
                        "type": "integer",
                        "format": "int64"
                    },
                    {
                        "in": "query",
                        "name": "published",
                        "description": "true or false",
                        "type": "boolean"
                    },
                    {
                        "in": "query",
                        "name": "property_type",
                        "description": "Hotel, House, Apartment, Villa, Resort or Hostel",
                        "type": "string"
                    },
                    {
                        "in": "query",
                        "name": "feed",
                        "description": "11, 12, 22 or 24",
                        "type": "integer",
                        "format": "int64"
                    },
                    {
                        "in": "query",
                        "name": "min_bedroom",
                        "description": "lowest bedroom count to include",
                        "type": "integer",
                        "format": "int64"
                    },
                    {
                        "in": "query",
                        "name": "amenities",
                        "description": "comma separated string list",
                        "type": "string"
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "description": "how many results to return",
                        "type": "integer",
                        "format": "int64"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/models.ListResponse"
                        }
                    },
                    "400": {
                        "description": "{object} models.ErrorResponse"
                    },
                    "500": {
                        "description": "{object} models.ErrorResponse"
                    }
                }
            }
        },
        "/properties/{id}": {
            "get": {
                "tags": [
                    "properties"
                ],
                "description": "Return one property by its id\n\u003cbr\u003e",
                "operationId": "PropertyController.Get property by id",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "description": "property id",
                        "required": true,
                        "type": "string"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/models.PropertyResponse"
                        }
                    },
                    "400": {
                        "description": "{object} models.ErrorResponse"
                    },
                    "404": {
                        "description": "{object} models.ErrorResponse"
                    },
                    "500": {
                        "description": "{object} models.ErrorResponse"
                    }
                }
            }
        }
    },
